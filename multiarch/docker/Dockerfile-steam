ARG TARGETPLATFORM
FROM scratch AS steam
FROM scratch AS devtools
FROM scratch AS mods
FROM --platform=linux/amd64 docker.io/library/debian:trixie-slim AS validated
RUN apt-get update && apt-get install -y --no-install-recommends bash jq ca-certificates && apt-get clean
COPY --from=devtools validate-steam-cache.sh /scripts/validate-steam-cache.sh
COPY --from=devtools lib/steam-cache.sh /scripts/lib/steam-cache.sh
COPY --from=steam / /cache/steam/
RUN bash /scripts/validate-steam-cache.sh /cache/steam

FROM validated AS game
RUN mkdir -p /data/Stardew && cp -a /cache/steam/game /data/Stardew/game
ENV GAME_PATH=/data/Stardew/game
ARG SMAPI_VERSION=4.0.8
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip libicu76 && apt-get clean
COPY --from=devtools container/install-smapi.sh /install-smapi.sh
RUN bash /install-smapi.sh

# GLX support is required; the earlier v4.6 base did not provide it.
FROM --platform=$TARGETPLATFORM docker.io/jlesage/baseimage-gui:debian-13-v4.14
ARG TARGETARCH
ARG BOX64_PACKAGE=box64
ARG BOX64_VERSION=0.4.5+20260919.38f4831-1
ARG BOX64_REPO_COMMIT=d444abc7fb30603e3129c338cd880dab1a2723f9
ENV APP_NAME=StardewValley GAME_PATH=/data/Stardew/game STARDEW_MODDED=1 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
RUN case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac && \
    test "$(dpkg --print-architecture)" = "$TARGETARCH"
COPY --from=validated /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=devtools container/install-packages.sh /install-packages.sh
COPY build/setup-arch /build/setup-arch
RUN bash /build/setup-arch
RUN bash /install-packages.sh \
    xterm gettext-base jq procps locales libasound2t64 libgl1 libglu1-mesa \
    libicu76 libssl3t64 zlib1g libstdc++6 mesa-utils
COPY --from=game /data/Stardew/game/ /data/Stardew/game/
COPY --from=game /cache/steam/steam-sdk/ /data/.steam/
COPY --from=mods / /data/Stardew/game/Mods/
COPY --from=devtools container/startapp.sh /startapp.sh
COPY --from=devtools container/exec-game.sh /opt/stardew/exec-game.sh
RUN test -s "/data/Stardew/game/Mods/Always On Server/manifest.json" && \
    chmod +x /startapp.sh /opt/stardew/exec-game.sh && chown -R 1000:1000 /data
