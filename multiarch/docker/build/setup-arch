#!/bin/bash
set -euo pipefail
architecture=$(dpkg --print-architecture)
[[ "${TARGETARCH:?}" == "$architecture" ]] ||
    { printf 'Build architecture does not match container architecture.\n' >&2; exit 1; }
case "$architecture" in
    amd64|arm64) printf 'Native %s image: no game emulation.\n' "$architecture" ;;
    *) printf 'Unsupported architecture: %s\n' "$architecture" >&2; exit 1 ;;
esac
if command -v box64 >/dev/null; then
    printf 'Unexpected Box64 in native runtime base.\n' >&2
    exit 1
fi
