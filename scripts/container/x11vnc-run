#!/bin/bash
set -euo pipefail
password=
for candidate in /config/.vncpass /tmp/.vncpass; do
    if [ -s "$candidate" ]; then
        password=$candidate
        break
    fi
done
if [ -z "$password" ]; then
    echo "No VNC password file; refusing unauthenticated custom VNC startup." >&2
    exit 1
fi
if [ "${SECURE_CONNECTION:-0}" != 0 ] || [ "${WEB_AUTHENTICATION:-0}" != 0 ]; then
    echo "Custom x11vnc currently supports VNC auth over a trusted loopback/SSH connection only." >&2
    exit 1
fi
exec /usr/bin/x11vnc -display "${DISPLAY:?}" -rfbport 5900 \
    -forever -shared -noxdamage -reopen -rfbauth "$password" -desktop "${APP_NAME}"
